# Copy to devloop/.env (gitignored) and fill in.

# Required — Orca API token (base64 string from your Orca config).
ORCA_API_TOKEN=

# Optional — Slack/Teams webhook. Leave empty to disable webhook notifications
# during dev runs.
NOTIFY_WEBHOOK_URL=

# Optional — override the sandbox repo for a one-off experiment.
# SANDBOX_REPO=owner/repo
